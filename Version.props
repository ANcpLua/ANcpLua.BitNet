<Project>
  <!--
    LOCAL OVERRIDE — ANcpLua.BitNet
    Directory.Packages.props imports this before the SDK-shipped truth is in scope,
    so every referenced version variable must be defined here.
  -->
  <PropertyGroup Label="Roslyn.Utilities (sibling repo)">
    <ANcpLuaRoslynUtilitiesVersion>2.2.48</ANcpLuaRoslynUtilitiesVersion>
  </PropertyGroup>

  <PropertyGroup Label="Microsoft.Agents (MAF 1.13.0)">
    <MicrosoftAgentsAIVersion>1.13.0</MicrosoftAgentsAIVersion>
  </PropertyGroup>

  <PropertyGroup Label="Microsoft.Extensions">
    <MicrosoftExtensionsAIVersion>10.7.0</MicrosoftExtensionsAIVersion>
    <SystemClientModelVersion>1.10.0</SystemClientModelVersion>
  </PropertyGroup>

  <PropertyGroup Label="Roslyn">
    <!-- ANcpLua.Roslyn.Utilities 2.2.47+ floors Microsoft.CodeAnalysis.CSharp at 5.9.0, the compiler of SDK 10.0.4xx. -->
    <MicrosoftCodeAnalysisCSharpVersion>5.9.0</MicrosoftCodeAnalysisCSharpVersion>
  </PropertyGroup>

</Project>
